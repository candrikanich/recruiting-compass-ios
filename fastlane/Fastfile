require "json"
require "tmpdir"
require "fileutils"

default_platform(:ios)

REPO_ROOT = File.expand_path("..", __dir__)
METADATA_PATH = File.join(REPO_ROOT, "fastlane/metadata")
SCREENSHOT_SOURCE = File.join(REPO_ROOT, "planning/app-store")
DEVICE_FOLDERS = %w[iphone ipad].freeze
PBXPROJ_PATH = File.join(REPO_ROOT, "TheRecruitingCompass/TheRecruitingCompass.xcodeproj/project.pbxproj")
RELEASE_NOTES_PATH = File.join(METADATA_PATH, "en-US/release_notes.txt")
MARKETING_VERSION_PATTERN = /MARKETING_VERSION = ([0-9.]+);/

# Key ID and Issuer ID are not secrets on their own; the .p8 is, and it stays outside the repo.
def asc_api_key
  key_id = ENV.fetch("ASC_KEY_ID", "XMUY74WLK7")
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: ENV.fetch("ASC_ISSUER_ID", "9359bbe9-c1f5-4821-8314-cce0788f1224"),
    key_filepath: ENV.fetch("ASC_KEY_PATH", File.expand_path("~/.appstoreconnect/AuthKey_#{key_id}.p8"))
  )
end

# The `deliver download_*` CLI commands only accept a JSON key file that embeds the key,
# so write one to a private temp dir that is deleted when the block returns.
def with_api_key_json
  Dir.mktmpdir("asc") do |dir|
    path = File.join(dir, "key.json")
    File.write(path, JSON.generate(asc_api_key.slice(:key_id, :issuer_id, :key, :in_house)))
    File.chmod(0o600, path)
    yield path
  end
end

# deliver expects <path>/<locale>/*.png and infers the device from pixel size;
# prefixing with the device keeps iPhone and iPad files from colliding.
def stage_screenshots(dir)
  locale_dir = File.join(dir, "en-US")
  FileUtils.mkdir_p(locale_dir)
  DEVICE_FOLDERS.each do |device|
    Dir[File.join(SCREENSHOT_SOURCE, device, "*.png")].sort.each do |png|
      FileUtils.cp(png, File.join(locale_dir, "#{device}-#{File.basename(png)}"))
    end
  end
  dir
end

# Every target/configuration must carry the same MARKETING_VERSION; a mismatch means a botched manual edit.
def current_marketing_version
  versions = File.read(PBXPROJ_PATH).scan(MARKETING_VERSION_PATTERN).flatten.uniq
  UI.user_error!("MARKETING_VERSION differs across configurations: #{versions.join(', ')}") unless versions.size == 1
  versions.first
end

def next_version(version, type)
  major, minor, patch = (version.split(".").map(&:to_i) + [0, 0, 0]).first(3)
  case type
  when "major" then "#{major + 1}.0.0"
  when "minor" then "#{major}.#{minor + 1}.0"
  when "patch" then "#{major}.#{minor}.#{patch + 1}"
  else UI.user_error!("type must be patch, minor or major (got #{type.inspect})")
  end
end

def release_notes!
  notes = File.exist?(RELEASE_NOTES_PATH) ? File.read(RELEASE_NOTES_PATH).strip : ""
  UI.user_error!("#{RELEASE_NOTES_PATH} is empty — App Store updates need \"What's New\" text") if notes.empty?
  notes
end

platform :ios do
  desc "Bump MARKETING_VERSION in every configuration. Usage: fastlane bump_version type:patch|minor|major"
  lane :bump_version do |options|
    from = current_marketing_version
    to = next_version(from, options.fetch(:type, "patch").to_s)
    File.write(PBXPROJ_PATH, File.read(PBXPROJ_PATH).gsub(MARKETING_VERSION_PATTERN, "MARKETING_VERSION = #{to};"))
    UI.success("MARKETING_VERSION #{from} → #{to}")
    UI.message("Next: commit on a branch (chore: bump version to #{to}), write release notes, " \
               "and add a WhatsNewCatalog entry if users should hear about it. See docs/RELEASE.md.")
  end

  desc "Create/refresh the App Store version for the current MARKETING_VERSION with release notes + phased release"
  lane :prepare_release do
    version = current_marketing_version
    release_notes!
    deliver(
      api_key: asc_api_key,
      app_version: version,
      metadata_path: METADATA_PATH,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      phased_release: true,
      force: true
    )
    UI.success("App Store version #{version} ready. Attach a build with: fastlane submit_release build:<number>")
  end

  desc "Attach an uploaded build to the current version and submit for review. Usage: fastlane submit_release build:34"
  lane :submit_release do |options|
    build = options[:build] or UI.user_error!("Pass the Xcode Cloud build number: fastlane submit_release build:34")
    version = current_marketing_version
    release_notes!
    deliver(
      api_key: asc_api_key,
      app_version: version,
      build_number: build.to_s,
      metadata_path: METADATA_PATH,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: true,
      # Phased release ramps 1% → 100% over 7 days and can be paused in App Store Connect.
      phased_release: true,
      automatic_release: options.fetch(:automatic_release, true),
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false },
      force: true
    )
    UI.success("#{version} (#{build}) submitted. After approval, tag the build's commit: git tag v#{version} <sha>")
  end

  desc "Read-only: download the live App Store listing text into fastlane/metadata"
  lane :pull_metadata do
    with_api_key_json do |key_path|
      sh("fastlane", "deliver", "download_metadata",
         "--api_key_path", key_path,
         "--metadata_path", METADATA_PATH,
         "--force")
    end
  end

  desc "Read-only: download the live App Store screenshots into fastlane/screenshots (gitignored)"
  lane :pull_screenshots do
    with_api_key_json do |key_path|
      sh("fastlane", "deliver", "download_screenshots",
         "--api_key_path", key_path,
         "--screenshots_path", File.join(REPO_ROOT, "fastlane/screenshots"))
    end
  end

  desc "Upload fastlane/metadata text to the editable App Store version (no screenshots, no submit)"
  lane :push_metadata do
    deliver(
      api_key: asc_api_key,
      metadata_path: METADATA_PATH,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      # Skip the interactive HTML preview prompt; review happens on the metadata diff instead.
      force: true
    )
  end

  desc "Replace App Store screenshots with planning/app-store/{iphone,ipad} (no metadata, no submit)"
  lane :push_screenshots do
    Dir.mktmpdir("screenshots") do |dir|
      deliver(
        api_key: asc_api_key,
        screenshots_path: stage_screenshots(dir),
        overwrite_screenshots: true,
        skip_metadata: true,
        skip_binary_upload: true,
        submit_for_review: false,
        run_precheck_before_submit: false
      )
    end
  end
end
