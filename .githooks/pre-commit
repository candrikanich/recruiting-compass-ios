#!/usr/bin/env bash
# Pre-commit hook: SwiftLint + print() guard + TODO/FIXME warning
# Install: git config core.hooksPath .githooks  (or: make setup-hooks)

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$' || true)

if [ -z "$STAGED_SWIFT" ]; then
  exit 0
fi

FAILED=0

# ── 1. Block print() statements ───────────────────────────────────────────────
PRINT_HITS=$(echo "$STAGED_SWIFT" | xargs grep -n '^\s*print(' 2>/dev/null || true)
if [ -n "$PRINT_HITS" ]; then
  echo -e "${RED}[pre-commit] ERROR: print() statements found — remove before committing:${NC}"
  echo "$PRINT_HITS"
  FAILED=1
fi

# ── 2. Warn on TODO / FIXME ───────────────────────────────────────────────────
TODO_HITS=$(echo "$STAGED_SWIFT" | xargs grep -n 'TODO:\|FIXME:' 2>/dev/null || true)
if [ -n "$TODO_HITS" ]; then
  echo -e "${YELLOW}[pre-commit] WARNING: TODO/FIXME found (not blocking):${NC}"
  echo "$TODO_HITS"
fi

# ── 3. SwiftLint ──────────────────────────────────────────────────────────────
if command -v swiftlint &>/dev/null; then
  echo -e "${GREEN}[pre-commit] Running SwiftLint...${NC}"
  LINT_OUTPUT=$(echo "$STAGED_SWIFT" | xargs swiftlint lint --config .swiftlint.yml --quiet 2>&1 || true)
  LINT_ERRORS=$(echo "$LINT_OUTPUT" | grep ': error:' || true)
  if [ -n "$LINT_ERRORS" ]; then
    echo -e "${RED}[pre-commit] SwiftLint errors (fix before committing):${NC}"
    echo "$LINT_ERRORS"
    FAILED=1
  fi
  LINT_WARNINGS=$(echo "$LINT_OUTPUT" | grep ': warning:' || true)
  if [ -n "$LINT_WARNINGS" ]; then
    echo -e "${YELLOW}[pre-commit] SwiftLint warnings:${NC}"
    echo "$LINT_WARNINGS"
  fi
else
  echo -e "${YELLOW}[pre-commit] swiftlint not found — skipping lint (run: brew install swiftlint)${NC}"
fi

if [ "$FAILED" -eq 1 ]; then
  echo -e "${RED}[pre-commit] Commit blocked. Fix errors above and try again.${NC}"
  exit 1
fi

exit 0
