  // MARK: - Code Formatting Tests

  func testFormatCodeForVoiceOver_StandardFormat() {
    let viewModel = makeMockViewModel(role: .player, familyCode: "FAM-123456")
    let view = FamilyManagementPlayerView(viewModel: viewModel)

